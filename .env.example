# ============================================================
# 环境变量配置模板（复制为 .env 后填写真实 key）
# .env 已被 .gitignore 忽略，不会被提交到 Git
# ============================================================

# DeepSeek API Key —— AI 文章生成（https://platform.deepseek.com）
DEEPSEEK_API_KEY=your_deepseek_key_here

# Tavily API Key —— 新闻搜索（https://tavily.com）
TAVILY_API_KEY=your_tavily_key_here

# 可选：Bing 搜索 Key（search_provider 设为 bing 时使用）
# BING_SEARCH_KEY=your_bing_key_here
